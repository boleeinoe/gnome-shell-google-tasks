{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "useDefineForClassFields": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "./dist",
    "sourceMap": false,
    "skipLibCheck": true
  },
  "files": [
    "src/extension.ts",
    "src/prefs.ts",
    "src/tasksManager.ts",
    "src/textInteraction.ts",
    "src/taskStyle.ts",
    "src/taskTree.ts",
    "src/retry.ts",
    "src/links.ts",
    "src/persistence.ts",
    "src/settings.ts",
    "src/i18n.ts",
    "src/tasksSection.ts",
    "src/nestingCheck.ts"
  ],
  "include": [
    "src/ambient.d.ts"
  ]
}
